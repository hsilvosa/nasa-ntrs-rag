# === Data Storage ===
# All downloaded PDFs, metadata, parsed Markdown, chunks, Qdrant local store & evals
DATA_DIR=D:/datasets/nasa-ntrs

# === Vector Store (Qdrant) ===
# Leave QDRANT_URL empty to use embedded local Qdrant at ${DATA_DIR}/qdrant
# Or set QDRANT_URL=http://localhost:6333 when running via docker-compose
QDRANT_URL=
QDRANT_COLLECTION=nasa_ntrs_chunks

# === Embeddings & Reranker (runs on CUDA RTX 3060 automatically) ===
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
DEVICE=auto
EMBEDDING_BATCH_SIZE=32

# === LLM Provider ===
# Options: "openai_compatible" (llama-server, Ollama, OpenAI, Groq) | "gemini"
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=local-no-key-needed
LLM_MODEL=qwen3-4b-instruct
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# If using Gemini API instead:
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your_api_key_here
# LLM_MODEL=gemini-2.5-flash

# === Local GGUF Model Path (for scripts/serve_local_llm.ps1) ===
LOCAL_GGUF_PATH=D:/models/own/qwen3-4b-instruct-2507-base/qwen3-4b-instruct-2507-base-Q4_K_M.gguf

# === Retrieval Defaults ===
RETRIEVAL_TOP_K_DENSE=25
RETRIEVAL_TOP_K_SPARSE=25
RETRIEVAL_TOP_K_RERANK=5
ABSTENTION_SCORE_THRESHOLD=0.15
